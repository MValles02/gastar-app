{
	"name": "gastar-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky || echo '' && svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck:fast": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright test",
		"test:e2e:setup": "pnpm db:seed",
		"ci:env": "node scripts/ci-env.mjs",
		"db:generate": "drizzle-kit generate",
		"db:deploy": "node --env-file-if-exists=.env scripts/migrate.js",
		"db:seed": "node --env-file-if-exists=.env scripts/seed.js",
		"db:studio": "drizzle-kit studio",
		"user:create": "node --env-file-if-exists=.env scripts/create-user.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "^24",
		"@typescript/native": "npm:typescript@7",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.72.0",
		"better-auth": "^1.7.23",
		"bits-ui": "2.21.0",
		"clsx": "2.1.1",
		"drizzle-orm": "^0.45.4",
		"postgres": "^4.1.1",
		"svelte-sonner": "1.2.3",
		"tailwind-merge": "3.7.0",
		"tw-animate-css": "1.4.0",
		"unpdf": "^2.1.0",
		"vaul-svelte": "1.0.0-next.7"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
