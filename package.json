{
	"name": "gastar-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"hooks:install": "git config core.hooksPath scripts/git-hooks",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
		"db:seed": "node --env-file-if-exists=.env scripts/seed.js",
		"db:studio": "drizzle-kit studio",
		"user:create": "node --env-file-if-exists=.env scripts/create-user.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^24",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.58.0",
		"better-auth": "^1.7.10",
		"bits-ui": "2.19.5",
		"clsx": "2.1.1",
		"drizzle-orm": "^0.45.4",
		"postgres": "^3.4.9",
		"svelte-sonner": "1.2.1",
		"tailwind-merge": "3.7.0",
		"tw-animate-css": "1.4.0",
		"vaul-svelte": "1.0.0-next.7"
	}
}
