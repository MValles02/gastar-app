DATABASE_URL=postgres://gastar:gastar@localhost:5432/gastar
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# adapter-node needs this for form POSTs (CSRF); use the public https URL in production
ORIGIN=http://localhost:5173
# Production: MUST be set in Dokploy BEFORE (or with) deploying; the app refuses to start without it.
# Must equal CF-Connecting-IP (real client IP behind Cloudflare, used for login rate limiting).
# ADDRESS_HEADER=CF-Connecting-IP
# Resend (transactional email). Production: MUST be set before deploying; the app refuses to start without them.
# Leave RESEND_API_KEY unset in dev: emails go to the in-memory /dev/outbox instead.
RESEND_API_KEY=
# Bare sender address on the verified Resend domain, e.g. no-reply@example.com
EMAIL_FROM=
# Demo password for `pnpm db:seed` (required unless SEED_EXISTING_USER is set). Local only.
# The e2e specs log in with SEED_PASSWORD from the shell env, else demo1234.
SEED_PASSWORD=demo1234
# Mercado Pago link (optional; on only when all three are set). MP_CLIENT_SECRET and MP_TOKEN_KEY are secrets.
# The MP application must list <ORIGIN>/profile/mercado-pago/callback as a redirect URL.
# MP_TOKEN_KEY: base64 of 32 bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing MP_TOKEN_KEY forces every user to link again.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_TOKEN_KEY=
# Hours between automatic payment syncs (default 1, 0 = no automatic sync); the release report runs once a day at 08:00 Buenos Aires
# MP_SYNC_INTERVAL_HOURS=1
# Google sign-in (optional; on only when both are set). GOOGLE_CLIENT_SECRET is a secret.
# The Google client must list <ORIGIN>/api/auth/callback/google as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tests only
# GOOGLE_DISCOVERY_URL=
# MP_API_BASE_URL=
# MP_REPORT_POLL_MS=
