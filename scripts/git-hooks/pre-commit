#!/usr/bin/env bash
# Scan staged changes for secrets with the same gitleaks image CI uses.
set -euo pipefail

if ! command -v docker >/dev/null 2>&1; then
	# Fail closed: an unscanned commit must be a deliberate `git commit --no-verify`.
	echo "pre-commit: docker not found, cannot run the gitleaks scan." >&2
	echo "Install docker, or bypass deliberately with: git commit --no-verify" >&2
	exit 1
fi

# Pipe the staged diff in so the container never reads .git (broken inside worktrees).
# pipefail makes a git or docker failure block the commit.
git diff --cached --no-color -U0 | docker run --rm -i ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f stdin --redact --exit-code 1
