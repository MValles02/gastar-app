#!/usr/bin/env bash
# Scan staged changes for secrets with the same gitleaks image CI uses.
set -euo pipefail

if ! command -v docker >/dev/null 2>&1; then
	echo "pre-commit: docker not found, skipping gitleaks scan" >&2
	exit 0
fi

exec docker run --rm -v "$PWD:/repo" ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f git /repo --staged --redact --exit-code 1
